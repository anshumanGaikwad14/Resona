extends ../base.pug

block variables 
    - var template = "home"

block content
    .home 
        .home__wrapper 
            .home__center
                each single in home.data.single_text
                    .home__center__single
                        h1.home__center__single__text(class=`${single.type === 'Light' ? 'home__center__single__text--light': 'home__center__single__text--bold'}`)=single.title 

                .home__center__image
                    figure.home__center__image__media 
                        img.home__center__image__media__image(alt=home.data.image.alt src=home.data.image.url)
                
                .home__center__multiple 
                    each multiple in home.data.multiple_text 
                        h1.home__center__multiple__text(class=`${multiple.type === 'Light' ? 'home__center__multiple__text--light': 'home__center__multiple__text--bold'}`)=multiple.title

            a.home__button(href=Link(home.data.collections))
                p.home__button__link=home.data.button
